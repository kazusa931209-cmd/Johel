# Copy to .env on the machine that runs Docker Desktop (docker compose).
JWT_SECRET=change-me-in-local-docker

# Optional for LAN Docker — required to decrypt API keys encrypted during public deploy
# ENCRYPTION_KEY=<openssl rand -base64 32>

# Public internet deployment — use docker compose -f docker-compose.public.yml up -d --build
# PUBLIC_DOMAIN=johel.example.com
# ACME_EMAIL=you@example.com
# JWT_SECRET=<strong random string, min 32 chars>
# ENCRYPTION_KEY=<openssl rand -base64 32>
