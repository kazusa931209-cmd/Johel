DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET="change-me-in-local-dev"

# Turso (production / Vercel) — use libsql:// URL from `turso db show`
# TURSO_AUTH_TOKEN=
# Pending migrations on Turso: applied on Vercel Production build (scripts/migrate-deploy-turso.ts).
# Optional: pnpm db:migrate-deploy with Turso env vars (touches remote DB — use with care).

# Optional — encrypt stored API keys (recommended before public deploy)
# Generate: openssl rand -base64 32
# ENCRYPTION_KEY=

# Public internet deployment (Phase 83)
# PUBLIC_DEPLOY=true
# TRUST_PROXY=true
# PUBLIC_URL=https://johel.example.com
# SESSION_TTL=7d

# --- Docker Compose (copy to .env on the machine that runs Docker Desktop) ---
# JWT_SECRET=change-me-in-local-docker
# PUBLIC_DOMAIN=johel.example.com
# ACME_EMAIL=you@example.com
