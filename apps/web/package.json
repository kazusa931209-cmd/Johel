{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1 -p 4041",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -H 127.0.0.1 -p 4041",
    "lint": "eslint",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate-keys": "tsx --env-file=.env scripts/migrate-plaintext-api-keys.ts",
    "prisma": "prisma"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@johel/jd-meta": "workspace:*",
    "@johel/prompt-defaults": "workspace:*",
    "@johel/resume": "workspace:*",
    "@libsql/client": "^0.14.0",
    "@prisma/adapter-libsql": "^6.5.0",
    "@prisma/client": "^6.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "bcryptjs": "^3.0.2",
    "hono": "^4.7.5",
    "jose": "^6.0.10",
    "next": "15.5.25",
    "node-html-parser": "^9.0.3",
    "openai": "^7.10.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "prisma": "^6.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
