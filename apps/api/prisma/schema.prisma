generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  setting      Setting?
  workflows    Workflow[]
  profiles     Profile[]

  // SQLite table names are case-insensitive; plural avoids colliding with former PascalCase names.
  @@map("users")
}

model Setting {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  apiKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Workflow {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  language        String             @default("en")
  filteringPrompt String             @default("")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  metadata        WorkflowMetadata[]

  @@index([userId])
  @@map("workflows")
}

model WorkflowMetadata {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  key        String
  rulePrompt String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([workflowId, key])
  @@index([workflowId])
  @@map("workflowMetadata")
}

model Profile {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  birthDate  String?
  email      String?
  pn         String?
  residence  String?
  education  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  links      ProfileLink[]

  @@index([userId])
  @@map("profiles")
}

model ProfileLink {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key       String
  link      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, key])
  @@index([profileId])
  @@map("profileLinks")
}
