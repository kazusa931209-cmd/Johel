generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  setting      Setting?
  workflows    Workflow[]
  profiles     Profile[]
  companies    Company[]
  experiences  Experience[]
  aiUsages     AiUsage[]
  prompt       Prompt?
  generationProcess GenerationProcess?
  promptOptimizations PromptOptimization[]

  // SQLite table names are case-insensitive; plural avoids colliding with former PascalCase names.
  @@map("users")
}

model Setting {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  apiKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Workflow {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId       String?
  profile         Profile?             @relation(fields: [profileId], references: [id], onDelete: SetNull)
  name            String
  description     String?
  language        String               @default("en")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  companies       WorkflowCompany[]
  experiences     WorkflowExperience[]

  @@index([userId])
  @@index([profileId])
  @@map("workflows")
}

model WorkflowCompany {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([workflowId, companyId])
  @@index([workflowId])
  @@index([companyId])
  @@map("workflowCompanies")
}

model WorkflowExperience {
  id           String     @id @default(cuid())
  workflowId   String
  workflow     Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([workflowId, experienceId])
  @@index([workflowId])
  @@index([experienceId])
  @@map("workflowExperiences")
}

model Profile {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  birthDate  String?
  email      String?
  pn         String?
  residence  String?
  education  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  links      ProfileLink[]
  workflows  Workflow[]

  @@index([userId])
  @@map("profiles")
}

model ProfileLink {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key       String
  link      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, key])
  @@index([profileId])
  @@map("profileLinks")
}

model Company {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String
  priority    Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  metadata    CompanyMetadata[]
  workflows   WorkflowCompany[]

  @@index([userId])
  @@index([userId, priority])
  @@map("companies")
}

model CompanyMetadata {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
  @@map("companyMetadata")
}

model Experience {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  description String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  metadata    ExperienceMetadata[]
  workflows   WorkflowExperience[]

  @@index([userId])
  @@map("experiences")
}

model ExperienceMetadata {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  key          String
  value        String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([experienceId, key])
  @@index([experienceId])
  @@map("experienceMetadata")
}

model AiUsage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiProvider       String
  input            String
  output           String
  inputToken       Int
  outputToken      Int
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@map("aiUsage")
}

model Prompt {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verdictPrompt  String
  generatePrompt String   @default("")
  evaluatePrompt String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("prompts")
}

model GenerationProcess {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doVerdict               Boolean  @default(true)
  doEvaluate              Boolean  @default(true)
  usePromptOptimizationAi Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("generationProcess")
}

model PromptOptimization {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String
  sourceHash      String
  optimizedPrompt String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, kind, sourceHash])
  @@index([userId, kind])
  @@map("promptOptimizations")
}
