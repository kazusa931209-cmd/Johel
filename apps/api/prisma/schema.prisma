generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  setting      Setting?
  workflows    Workflow[]
  profiles     Profile[]
  companies    Company[]
  experiences  Experience[]
  aiUsages     AiUsage[]
  verdict      Verdict?

  // SQLite table names are case-insensitive; plural avoids colliding with former PascalCase names.
  @@map("users")
}

model Setting {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  apiKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Workflow {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  language        String             @default("en")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  metadata        WorkflowMetadata[]

  @@index([userId])
  @@map("workflows")
}

model WorkflowMetadata {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  key        String
  rulePrompt String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([workflowId, key])
  @@index([workflowId])
  @@map("workflowMetadata")
}

model Profile {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  birthDate  String?
  email      String?
  pn         String?
  residence  String?
  education  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  links      ProfileLink[]

  @@index([userId])
  @@map("profiles")
}

model ProfileLink {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key       String
  link      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, key])
  @@index([profileId])
  @@map("profileLinks")
}

model Company {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String
  priority    Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  metadata    CompanyMetadata[]

  @@index([userId])
  @@index([userId, priority])
  @@map("companies")
}

model CompanyMetadata {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
  @@map("companyMetadata")
}

model Experience {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  description String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  metadata    ExperienceMetadata[]

  @@index([userId])
  @@map("experiences")
}

model ExperienceMetadata {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  key          String
  value        String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([experienceId, key])
  @@index([experienceId])
  @@map("experienceMetadata")
}

model AiUsage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiProvider       String
  input            String
  output           String
  inputToken       Int
  outputToken      Int
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@map("aiUsage")
}

model Verdict {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verdictPrompt String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("verdicts")
}
