generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         String     @default("user")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  setting      Setting?
  profiles     Profile[]
  companies    Company[]
  experiences  Experience[]
  aiUsages     AiUsage[]
  prompt       Prompt?
  generationProcess GenerationProcess?

  // SQLite table names are case-insensitive; plural avoids colliding with former PascalCase names.
  @@map("users")
}

model Setting {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  apiKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Profile {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  birthDate  String?
  email      String?
  pn         String?
  residence       String?
  university      String?
  graduationYear  Int?
  degree          String?
  createdAt       DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  links      ProfileLink[]

  @@index([userId])
  @@map("profiles")
}

model ProfileLink {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key       String
  link      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, key])
  @@index([profileId])
  @@map("profileLinks")
}

model Company {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alias          String
  name           String
  whatCompanyIs  String
  domainAndStack String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("companies")
}

model Experience {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  problem     String
  actions     String
  outcome     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("experiences")
}

model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiProvider   String
  modelName    String
  generateType String
  input        String
  output       String
  inputToken   Int
  outputToken  Int
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@map("aiUsage")
}

model Prompt {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verdictPrompt       String
  generatePrompt      String   @default("")
  evaluatePrompt      String   @default("")
  verdictExtension    String   @default("")
  generateExtension   String   @default("")
  evaluateExtension   String   @default("")
  createdAt           DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("prompts")
}

model GenerationProcess {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doVerdict      Boolean  @default(true)
  doEvaluate     Boolean  @default(true)
  resumeLanguage String   @default("en")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("generationProcess")
}
