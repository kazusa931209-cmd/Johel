generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         String     @default("user")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  setting      Setting?
  profiles     Profile[]
  companies    Company[]
  experiences  Experience[]
  aiUsages     AiUsage[]
  generations  Generation[]
  prompt       Prompt?
  generationProcess GenerationProcess?

  // SQLite table names are case-insensitive; plural avoids colliding with former PascalCase names.
  @@map("users")
}

model Setting {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  apiKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Profile {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  birthDate  String?
  email      String?
  pn         String?
  residence       String?
  university      String?
  graduationYear  Int?
  graduationMonth Int?
  degree          String?
  createdAt       DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  links      ProfileLink[]

  @@index([userId])
  @@map("profiles")
}

model ProfileLink {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key       String
  link      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, key])
  @@index([profileId])
  @@map("profileLinks")
}

model Company {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayPriority Int      @default(1)
  alias           String
  name            String
  whatCompanyIs   String
  domainAndStack  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("companies")
}

model Experience {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  problem     String
  actions     String
  outcome     String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  embedding   ExperienceEmbedding?

  @@index([userId])
  @@map("experiences")
}

model ExperienceEmbedding {
  experienceId String     @id
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  model        String
  vector       Bytes
  updatedAt    DateTime   @updatedAt

  @@map("experienceEmbeddings")
}

model AiUsage {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationId String?
  generation   Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  aiProvider   String
  modelName    String
  generateType String
  input        String
  output       String
  inputToken   Int
  outputToken  Int
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([generationId])
  @@map("aiUsage")
}

model Generation {
  id                 String                  @id @default(cuid())
  publicId           String
  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  finalized          Boolean                 @default(false)
  inputToken         Int                     @default(0)
  outputToken        Int                     @default(0)
  activeStep         String
  jobJson            String
  combineJson        String
  verdictMarkdown    String?
  resumeJson         String?
  evaluationMarkdown String?
  doVerdict          Boolean
  doEvaluate         Boolean
  resumeLanguage     String
  verdictPrompt      String
  generatePrompt     String
  evaluatePrompt     String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  aiUsages           AiUsage[]
  jobEmbedding       GenerationJobEmbedding?

  @@unique([userId, publicId])
  @@index([userId, createdAt])
  @@map("generations")
}

model GenerationJobEmbedding {
  generationId String     @id
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  model        String
  vector       Bytes
  sourceHash   String
  updatedAt    DateTime   @updatedAt

  @@map("generationJobEmbeddings")
}

model Prompt {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verdictPrompt       String
  generatePrompt      String   @default("")
  evaluatePrompt      String   @default("")
  verdictExtension    String   @default("")
  generateExtension   String   @default("")
  evaluateExtension   String   @default("")
  createdAt           DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("prompts")
}

model GenerationProcess {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doVerdict                 Boolean  @default(true)
  doEvaluate                Boolean  @default(true)
  resumeLanguage            String   @default("en")
  experienceAdvisePoolDepth String   @default("normal")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("generationProcess")
}
